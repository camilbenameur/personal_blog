---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isoDay, isoMonth, monthLabel } from '../lib/dates.js';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// Newest year first; posts inside a year keep the newest-first order.
const years = [];
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  const group = years.find((y) => y.year === year);
  if (group) group.posts.push(post);
  else years.push({ year, posts: [post] });
}
---
<BaseLayout
  title="Blog | Camil Benameur"
  description="Write-ups of software I have built, mostly in Go."
  current="archive"
>
  <div class="col">
    <div class="secbar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span><span>~/blog</span><span class="secbar__rule"></span>
    </div>
    <h1 class="h2">Blog</h1>
    {posts.length === 0 && <p class="small empty">No posts yet.</p>}
    {years.map(({ year, posts: inYear }) => (
      <>
        <h2 class="yearhead">{year}/</h2>
        <ol class="rows">
          {inYear.map((post) => (
            <li class="row">
              <time class="row__date" datetime={isoDay(post.data.pubDate)}>{monthLabel(post.data.pubDate)}</time>
              <div>
                <div class="row__top">
                  <h3 class="row__title"><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
                  {post.data.correction && (
                    <span class="badge">corrected <time datetime={isoMonth(post.data.correction.date)}>{monthLabel(post.data.correction.date)}</time></span>
                  )}
                </div>
                <p class="row__line small">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </>
    ))}
  </div>
</BaseLayout>
