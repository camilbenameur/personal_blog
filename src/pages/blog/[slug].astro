---
import { getCollection } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
  );
  // Oldest first: the previous post is the older one, the next post the newer one.
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, previous: posts[i - 1], next: posts[i + 1] },
  }));
}
const { post, previous, next } = Astro.props;
const { Content } = await post.render();
---
<BlogPostLayout post={post} previous={previous} next={next}><Content /></BlogPostLayout>
