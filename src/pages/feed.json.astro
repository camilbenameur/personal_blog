---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const feed = {
  version: "https://jsonfeed.org/version/1.1",
  title: "Camil Benameur - Technical Blog",
  home_page_url: "https://blog.camilbenameur.com",
  feed_url: "https://blog.camilbenameur.com/feed.json",
  description: "Personal blog on software engineering, distributed systems, and AI infrastructure",
  authors: [
    {
      name: "Camil Benameur",
      url: "https://camilbenameur.com"
    }
  ],
  items: sortedPosts.map(post => ({
    id: `https://blog.camilbenameur.com/blog/${post.data.slug}`,
    url: `https://blog.camilbenameur.com/blog/${post.data.slug}`,
    title: post.data.title,
    content_text: post.data.description,
    date_published: new Date(post.data.pubDate).toISOString(),
    authors: [{ name: post.data.author }],
    tags: post.data.tags
  }))
};
---
{JSON.stringify(feed, null, 2)}
