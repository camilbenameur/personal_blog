---
import BaseLayout from './BaseLayout.astro';
import { dayLabel, isoDay, isoMonth, monthLabel } from '../lib/dates.js';
const { post, previous, next } = Astro.props;
const { title, description, pubDate, updatedDate, correction } = post.data;
// A post with a correction shows the badge. A post only revised (updatedDate, no correction) says so plainly.
const showUpdated = !correction && updatedDate;
const more = [
  previous && { post: previous, label: 'Previous', next: false },
  next && { post: next, label: 'Next', next: true },
].filter(Boolean);
---
<BaseLayout title={`${title} | Camil Benameur`} description={description} current="archive">
  <article class="post">
    <div class="secbar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="win__title">~/blog/{post.slug}.md</span>
      <span class="secbar__rule"></span>
    </div>

    <h1 class="post__title">{title}</h1>
    <p class="post__meta">
      <time datetime={isoDay(pubDate)}>{dayLabel(pubDate)}</time>
      {correction && (
        <span class="badge">corrected <time datetime={isoMonth(correction.date)}>{monthLabel(correction.date)}</time></span>
      )}
      {showUpdated && (
        <span>updated <time datetime={isoDay(updatedDate)}>{dayLabel(updatedDate)}</time></span>
      )}
    </p>

    {correction && (
      <section class="win correction" aria-label="Correction">
        <div class="win__bar win__bar--tall">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win__title">// correction</span>
          <time class="win__slot" datetime={isoDay(correction.date)}>{dayLabel(correction.date)}</time>
        </div>
        <p>{correction.text}</p>
      </section>
    )}

    <div class="prose"><slot /></div>

    {more.length > 0 && (
      <nav class="post__end" aria-label="More posts">
        {more.map((m) => (
          <a class={m.next ? 'pn pn--next' : 'pn'} href={`/blog/${m.post.slug}/`}>
            <span class="pn__k">{m.label}</span>
            <span class="pn__t">{m.post.data.title}</span>
            <span class="pn__d">{monthLabel(m.post.data.pubDate)}</span>
          </a>
        ))}
      </nav>
    )}
  </article>
</BaseLayout>
