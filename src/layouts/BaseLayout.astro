---
// Fonts are self-hosted (font-src 'self'): one variable file per subset, font-display: swap.
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
// The latin subset of Geist carries every title and paragraph: fetch it early (same hashed URL as the CSS uses).
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
// global.css pulls in the shared tokens and base (art direction V1 "Terminal"), then prose.css, then Tailwind.
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const {
  title,
  description = 'Write-ups of software I have built, mostly in Go. By Camil Benameur, software engineer in Nice, France.',
  current = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-site="blog">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <!-- One tag, no media query: /theme.js keeps it in step with the chosen theme. -->
    <meta name="theme-color" content="#0B0D11" />
    <!-- Blocking on purpose: sets html[data-theme] before first paint. -->
    <script is:inline src="/theme.js"></script>
    <link rel="preload" as="font" type="font/woff2" crossorigin href={geistLatin} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/feed+json" title="Camil Benameur - Blog" href="/feed.json" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Icons />
    <SiteHeader current={current} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script is:inline src="/keys.js" defer></script>
    <script is:inline src="/ui.js" defer></script>
  </body>
</html>
