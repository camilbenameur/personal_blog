---
interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description = "Personal blog on software engineering, distributed systems, and AI infrastructure" } = Astro.props;

const navLinks = [
  { id: "hero", label: "Home", href: "https://camilbenameur.com/#hero" },
  { id: "about", label: "About", href: "https://camilbenameur.com/#about" },
  { id: "skills", label: "Skills", href: "https://camilbenameur.com/#skills" },
  { id: "projects", label: "Projects", href: "https://camilbenameur.com/#projects" },
  { id: "blog", label: "Blog", href: "/blog", isActive: true },
  { id: "contact", label: "Contact", href: "https://camilbenameur.com/#contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen font-sans antialiased">
    <!-- Navigation synced with Portfolio Navigation.jsx -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-gray-900 shadow-lg py-3 transition-all duration-300">
      <nav class="container mx-auto px-4 flex justify-between items-center">
        <!-- Logo matching Portfolio branding -->
        <a 
          href="https://camilbenameur.com" 
          class="text-xl md:text-2xl font-bold text-white flex items-center gap-2 hover:scale-105 transition-transform"
        >
          <div class="h-8 w-8 bg-blue-600 rounded-md flex items-center justify-center text-white font-bold">
            CB
          </div>
          <span>Camil Benameur</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`relative px-4 py-2 rounded-md transition-colors ${
                link.isActive
                  ? "text-blue-400"
                  : "text-gray-300 hover:text-blue-400"
              }`}
            >
              {link.label}
              {link.isActive && (
                <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 h-1 w-8 bg-blue-500 rounded-full"></div>
              )}
            </a>
          ))}
        </div>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden p-2 text-white"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </nav>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden bg-gray-900 border-t border-gray-800">
        <div class="container mx-auto px-4 py-4 space-y-2">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`block px-4 py-2 rounded-md transition-colors ${
                link.isActive
                  ? "text-blue-400 bg-gray-800"
                  : "text-gray-300 hover:text-blue-400 hover:bg-gray-800"
              }`}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </header>
    
    <!-- Spacer for fixed header -->
    <div class="h-16"></div>
    
    <main class="max-w-4xl mx-auto px-4 py-12">
      <slot />
    </main>
    
    <!-- Footer synced with Portfolio Footer.jsx -->
    <footer class="bg-gradient-to-t from-gray-900 to-gray-800 text-white py-12 mt-auto">
      <div class="container mx-auto px-4">
        <!-- Logo and information centered -->
        <div class="max-w-md mx-auto text-center">
          <div class="flex items-center mb-4 justify-center">
            <div class="h-10 w-10 bg-blue-600 rounded-md flex items-center justify-center text-white font-bold mr-3">
              CB
            </div>
            <span class="text-xl font-bold">Camil Benameur</span>
          </div>
          <p class="text-gray-300 mb-6">
            Creating elegant solutions to complex problems.
          </p>
          <div class="flex space-x-3 justify-center">
            <a 
              href="https://github.com/camilbenameur" 
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gray-700 hover:bg-gray-600 p-2 rounded-full transition-colors hover:-translate-y-1 transform duration-200"
              aria-label="GitHub Profile"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a 
              href="https://www.linkedin.com/in/camil-benameur-14a762194/" 
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gray-700 hover:bg-gray-600 p-2 rounded-full transition-colors hover:-translate-y-1 transform duration-200"
              aria-label="LinkedIn Profile"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a 
              href="https://twitter.com/camilbenameur" 
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gray-700 hover:bg-gray-600 p-2 rounded-full transition-colors hover:-translate-y-1 transform duration-200"
              aria-label="Twitter Profile"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
        
        <!-- Copyright -->
        <div class="mt-10 pt-6 border-t border-gray-700/50 text-center">
          <p class="text-gray-400 text-sm">
            &copy; {new Date().getFullYear()} Camil Benameur. All rights reserved.
          </p>
          
          <!-- Scroll to top button -->
          <div class="mt-6">
            <a 
              href="#" 
              class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 p-2 rounded-full transition-all shadow-lg shadow-blue-500/20 hover:scale-110"
              aria-label="Scroll to top"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      
      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
